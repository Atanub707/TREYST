---
import JerseyCard from './JerseyCard.astro';
import SectionHeading from './SectionHeading.astro';
import CtaBand from './CtaBand.astro';
import { jerseys } from '../data/jerseys.mjs';
import { t, localizePath } from '../i18n/utils.mjs';

const { lang } = Astro.props;
const contactPath = localizePath('/samband', lang);
const steps = [1, 2, 3].map((n) => ({
  title: t(lang, `tryon.step${n}.title`),
  desc: t(lang, `tryon.step${n}.desc`),
}));
---
<section class="bg-fjord pt-20">
  <div class="mx-auto max-w-7xl px-4 pb-20 pt-14 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-bright">{t(lang, 'tryon.eyebrow')}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-white md:text-5xl">{t(lang, 'tryon.h1')}</h1>
    <p class="mt-6 max-w-2xl text-lg font-light leading-relaxed text-white/75">{t(lang, 'tryon.intro')}</p>
  </div>
</section>

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading title={t(lang, 'tryon.gallery')} />
    <div class="mt-14 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
      {jerseys.map((jersey) => (
        <JerseyCard lang={lang} jersey={jersey} contactPath={contactPath} />
      ))}
    </div>
  </div>
</section>

<section class="bg-fog py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading align="center" title={t(lang, 'tryon.how')} />
    <ol class="mt-14 grid gap-10 sm:grid-cols-3">
      {steps.map((step) => (
        <li class="border-t border-ink/10 pt-6">
          <h2 class="text-xl font-bold text-ink">{step.title}</h2>
          <p class="mt-2 leading-relaxed text-ink/70">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<CtaBand lang={lang} />
