---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { t, localizePath } from '../i18n/utils.mjs';

const { lang } = Astro.props;
const href = localizePath('/roynd', lang);
---
<section class="bg-fog py-20">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 md:flex-row md:items-center lg:px-8">
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">{t(lang, 'tryon.openCta.title')}</h2>
      <p class="mt-3 text-lg text-ink/70">{t(lang, 'tryon.openCta.desc')}</p>
    </div>
    <Button href={href} variant="primary">
      {t(lang, 'tryon.openCta.button')} <Icon name="arrow" class="h-5 w-5" />
    </Button>
  </div>
</section>
