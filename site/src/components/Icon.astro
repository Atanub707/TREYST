  shirt: '<path d="M20.4 8.5 16 6l-1-2H9L8 6 3.6 8.5a2 2 0 0 0-1 2.3l.7 2.7a1 1 0 0 0 1.2.7L8 13v7a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-7l3.5 1.2a1 1 0 0 0 1.2-.7l.7-2.7a2 2 0 0 0-1-2.3z"/>',
