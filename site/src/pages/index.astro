---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import { t } from '../i18n/utils.mjs';

const lang = 'fo';
---
<BaseLayout
  lang={lang}
  title={t(lang, 'meta.home.title')}
  description={t(lang, 'meta.home.description')}
  path="/"
  altPath="/en/"
>
  <HomePage lang={lang} />
</BaseLayout>
