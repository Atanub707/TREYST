---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/AboutPage.astro';
import { t } from '../../i18n/utils.mjs';

const lang = 'en';
---
<BaseLayout
  lang={lang}
  title={t(lang, 'meta.about.title')}
  description={t(lang, 'meta.about.description')}
  path="/en/about"
  altPath="/um-okkum"
>
  <AboutPage lang={lang} />
</BaseLayout>
